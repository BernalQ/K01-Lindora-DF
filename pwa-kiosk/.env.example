# Variables de entorno operativas del kiosko (ver services/redConfig.ts,
# services/datafono.ts y services/wsdf.ts). Copiar este archivo a `.env` (o
# `.env.local`, que no se versiona por el patrón `*.local` de .gitignore) y
# ajustar los valores para el kiosko/tienda donde se vaya a desplegar este
# build. Ninguna variable es obligatoria: si no se define, el código cae al
# valor por defecto documentado en el archivo .ts correspondiente (los
# valores de abajo son justo esos valores por defecto actuales).

# Identificador de ESTE kiosko/caja (ver services/consecutivo.ts). Determina
# el prefijo del consecutivo de orden, cuál kiosko es el Master del catálogo
# (K001 siempre, ver esKioskoMaster en services/catalogOverrides.ts) y cuál IP
# es "la propia" vs. "la del otro kiosko" (ver services/kioskoSyncConfig.ts).
#
# NORMALMENTE NO HACE FALTA CONFIGURAR ESTA VARIABLE: el MISMO build/.env
# puede copiarse a ambas terminales sin tocar nada aquí — el operador elige a
# mano cuál kiosko es cada máquina desde el panel de administración de la PWA
# ("ADMIN" -> "Kiosko"), una sola vez por terminal; esa elección queda
# guardada en el navegador y sobrevive recargas y reinicios.
#
# Dejar esta variable SIN DEFINIR (comentada o vacía) en el caso normal
# (selección manual desde el panel de administración). Sólo configurarla acá
# como OVERRIDE si se quiere fijar el kiosko desde el build/despliegue en vez
# de elegirlo desde la pantalla — si se define aquí, tiene prioridad absoluta
# y el panel de administración deja de poder cambiarla para esa terminal.
# VITE_CAJA_ID=K002

# IP de la impresora térmica de la estación Cliente (caja).
VITE_IP_IMPRESORA_CLIENTE=10.0.5.247

# IP de la impresora térmica de la estación Carnicería.
VITE_IP_IMPRESORA_CARNICERIA=10.0.5.248

# IP de la impresora térmica de la estación Parrilla (id interno "restaurante").
VITE_IP_IMPRESORA_PARRILLA=10.0.5.249

# IP del gateway de red del kiosko (salida hacia AWS IoT Core y hacia el datáfono BAC).
VITE_IP_GATEWAY=10.0.5.250

# ID del terminal físico del datáfono BAC (Transaction Manager) conectado a este kiosko.
VITE_DATAFONO_TERMINAL_ID=EMVUFID1

# ID de tienda asignado por Codisa a este kiosko (factura electrónica).
VITE_CODISA_ID_TIENDA=22

# Token compartido para autenticarse contra print-bridge (clientes/factura/
# ventas/system, puerto 4000, ver services/kioskToken.ts). Vacío por
# defecto: no se manda el header x-kiosk-token y print-bridge no lo exige
# (fail-open), igual que hoy. Si se configura aquí, hay que configurar el
# MISMO valor en KIOSK_TOKEN del `.env` de `print-bridge/` (ver
# `.env.example` ahí) — si sólo uno de los dos lados tiene el valor, las
# peticiones reales empezarán a fallar con 401.
VITE_KIOSK_TOKEN=

# Las IPs de las máquinas de los dos kioskos físicos (para la sincronización
# directa entre ellos — mesas/catálogo/resincronización) YA NO se configuran
# acá: están hardcodeadas en services/kioskoSyncConfig.ts (K001=10.0.5.250,
# K002=10.0.5.251) a propósito, para que la ÚNICA configuración que el
# operador deba hacer bien sea elegir el kiosko correcto desde ADMIN ->
# Kiosko (ver services/consecutivo.ts y components/screens/AdminScreen.tsx).
# Si alguna vez cambian las IPs físicas reales de las máquinas, hay que
# editar esa tabla directamente y reconstruir el build.

# API key para autenticar (header x-api-key) el envío de copia de cada venta
# a nuestro backend propio en AWS (ver services/awsVentas.ts) — una por
# kiosko, A DIFERENCIA de las IPs de arriba, esta SÍ es una credencial: no se
# hardcodea en el código (no debe quedar commiteada en el repositorio), sólo
# vive en el `.env` real de cada máquina (no versionado, ver .gitignore). El
# MISMO `.env` (con AMBAS claves abajo) puede copiarse a los dos kioskos
# físicos sin tocar nada: cada máquina usa sólo la que corresponde a su
# CAJA_ID (elegido en ADMIN -> Kiosko), igual que con el resto de la
# configuración. Dejar vacío en este archivo de ejemplo; pedir los valores
# reales a quien administra el backend de AWS y completarlos sólo en el
# `.env` real de cada kiosko.
VITE_AWS_VENTAS_API_KEY_K001=
VITE_AWS_VENTAS_API_KEY_K002=
