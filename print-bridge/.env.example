# Puerto donde escucha el print-bridge (la PWA le hace POST /print aquí)
PORT=4000

# IPs/puerto de las 3 impresoras térmicas ZKTeco (ESC/POS sobre TCP, puerto
# 9100) y el gateway de red del kiosko ahora viven en `config/printers.json`
# (ver print-bridge/src/printers/config.ts), NO en este archivo — ese JSON es
# la fuente de verdad pensada para "fácil mantenimiento" (editar + reiniciar
# el servicio, sin tocar código). Las variables de abajo siguen soportadas
# como override puntual de emergencia (ej. probar otra IP sin editar el
# JSON) y tienen prioridad sobre el JSON si se definen; déjalas vacías/sin
# descomentar para usar siempre lo que diga `config/printers.json`.
# PRINTER_CARNICERIA_IP=10.0.5.248
# PRINTER_RESTAURANTE_IP=10.0.5.249
# PRINTER_CLIENTE_IP=10.0.5.247
# PRINTER_PORT=9100
# GATEWAY_IP=10.0.5.250

# Origen permitido para CORS (la PWA sirviéndose en el mismo M8W)
CORS_ORIGIN=http://localhost:5173

# Nombres de proceso (separados por coma) que se cierran con `taskkill` al
# usar "Salir de kiosko" desde la PWA (ver routes/system.ts). Por defecto
# incluye Chrome y Edge; ajustar si la terminal usa otro navegador.
KIOSK_BROWSER_PROCESSES=chrome.exe,msedge.exe

# --- Facturación electrónica (factura.ts / clientesStore.ts) ---

# Datos del emisor, se imprimen en el encabezado del PDF de la factura
# (logo + leyenda centrada, ver services/pdfFactura.ts). Los valores por
# defecto en código ya son los datos reales del negocio; estas variables
# sólo permiten sobreescribirlos sin tocar código.
EMISOR_NOMBRE="Carnes Don Fernando"
EMISOR_ESLOGAN="El especialista en carnes"
EMISOR_DIRECCION="Santa Ana, C.C Vistana Este"
EMISOR_CORREO=santana@carnesdonfernado.com
EMISOR_TELEFONO=2282-0182
EMISOR_CEDULA=3101017589

# API de Codisa (envío de facturas a Hacienda). Mientras estas dos variables
# no estén configuradas, el envío se SIMULA (ver services/hacienda.ts) y el
# resto del flujo (PDF, correo, ticket) sigue funcionando con una clave
# interna de referencia, no una clave real autorizada por Hacienda.
CODISA_API_URL=
CODISA_API_KEY=

# SMTP para enviar el PDF de la factura por correo al cliente. Mientras no
# estén configuradas, el envío se SIMULA (ver services/email.ts).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
